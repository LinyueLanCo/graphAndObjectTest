        "conditions": [
          { "param": "justLanded", "expected": 1.0 },
          { "param": "moving", "expected": 0.0 },
          { "param": "facing", "expected": -1.0 }
        ]
      },
      {
        "from": "jump_end_r",
        "to": "idle_r",
        "conditions": [
          { "param": "animFinished", "expected": 1.0 }
        ]
      },
      {
        "from": "jump_end_l",
        "to": "idle_l",
        "conditions": [
          { "param": "animFinished", "expected": 1.0 }
        ]
      },
      {
        "from": "any",
        "to": "run_r",
        "conditions": [
          { "param": "inAir", "expected": 0.0 },
          { "param": "isJumpEnd", "expected": 0.0 },
          { "param": "moving", "expected": 1.0 },
          { "param": "sprinting", "expected": 1.0 },
          { "param": "facing", "expected": 1.0 }
        ]
      },
      {
        "from": "any",
        "to": "run_l",
        "conditions": [
          { "param": "inAir", "expected": 0.0 },
          { "param": "isJumpEnd", "expected": 0.0 },
          { "param": "moving", "expected": 1.0 },
          { "param": "sprinting", "expected": 1.0 },
          { "param": "facing", "expected": -1.0 }
