        "conditions": [
          { "param": "animFinished", "expected": 1.0 }
        ]
      },
      {
        "from": "any",
        "to": "jump_loop_r",
        "conditions": [
          { "param": "inAir", "expected": 1.0 },
          { "param": "isJumpStart", "expected": 0.0 },
          { "param": "facing", "expected": 1.0 }
        ]
      },
      {
        "from": "any",
